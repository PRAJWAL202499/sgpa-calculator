<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Marks Entry</title>
</head>
<body>
    <h1>Enter Details</h1>
    <form action="/calculate" method="post">
        <div>
            <label for="name">Enter Name:</label>
            <input type="text" id="name" placeholder="Enter name" name="name">
        </div>
        <div>
            <label for="usn">Enter USN:</label>
            <input type="text" id="usn" placeholder="Enter USN" name="usn">
        </div>

        <br>
        <h3>Enter Marks</h3>

        <div>
            <label for="dsdv">DSDV:</label>
            <input type="text" id="dsdv" placeholder="Enter DSDV marks" name="dsdv">
        </div>

        <div>
            <label for="epc">EPC:</label>
            <input type="text" id="epc" placeholder="Enter EPC marks" name="epc">
        </div>

        <div>
            <label for="na">NA:</label>
            <input type="text" id="na" placeholder="Enter NA marks" name="na">
        </div>

        <div>
            <label for="coa">COA:</label>
            <input type="text" id="coa" placeholder="Enter COA marks" name="coa">
        </div>

        <div>
            <label for="math">Math:</label>
            <input type="text" id="math" placeholder="Enter Math marks" name="math">
        </div>

        <div>
            <label for="adsdl">ADSDL:</label>
            <input type="text" id="adsdl" placeholder="Enter ADSDL marks" name="adsdl">
        </div>

        <div>
            <label for="lpl">LPL:</label>
            <input type="text" id="lpl" placeholder="Enter LPL marks" name="lpl">
        </div>

        <div>
            <label for="scr">SCR:</label>
            <input type="text" id="scr" placeholder="Enter SCR marks" name="scr">
        </div>
        <br>
        <button>Calculate</button>
    </form>
</body>
</html>