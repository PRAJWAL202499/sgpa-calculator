<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/ranking.css">
    <title>SGPA calculator</title>
    <style>
        h1{text-align: center;}
        a{text-decoration: none; text-align: center;}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/home"><i class="fas fa-calculator me-2"></i>SGPA Calculator</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link active" href="/home">Home</a>
            </div>
        </div>
    </nav>
    <div class="container text-align:middle ">
        <h1>Top 5 scores from our users</h1>
    </div>
    <br><br><br>
    <% for(let i=0 ; i<5 ; i++){ %>
        <div class="container ">
             <ol class="list-group ">
        <li class="list-group-item d-flex justify-content-between align-items-start">
          <div class="ms-2 me-auto">
            <div class="fw-bold"><%= i+1 %>.   <%= result[i].name %></div>
            <%= result[i].usn.toUpperCase(); %> Congrats on securing place <%= i+1 %> among our users
          </div>
          <span class="badge text-bg-dark rounded-pill">SGPA: <%= result[i].sgpa %></span>
        </li>
    </ol> 
        </div>
    <% } %>
    <footer class="r-footer">
        <div class="container text-center">
            <p class="mb-3">watch my other works on below socials</p>
            <div class="social-icons mb-3">
                <a href="https://github.com/PRAJWAL202499" target="_blank"><i class="fab fa-github"></i></a>
                <a href="https://www.linkedin.com/in/prajwal-g-s-aa0a4b352/" target="_blank"><i class="fab fa-linkedin"></i></a>
            </div>
            <p class="small text-muted">&copy; 2026 All Rights Reserved</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>